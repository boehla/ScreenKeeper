<UserControl x:Class="ScreenKeeper.Views.EditorToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:loc="clr-namespace:ScreenKeeper.Resources"
             xmlns:views="clr-namespace:ScreenKeeper.Views"
             Focusable="False"
             Cursor="Arrow"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanConverter x:Key="InverseBool" />
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="background" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="background" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="background" Property="Background" Value="#70FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#FF1E88E5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Ein/Aus-Knopf: Tag = Zustand (bool) -->
        <Style x:Key="StateButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <sys:Boolean>True</sys:Boolean>
                    </Trigger.Value>
                    <Setter Property="Background" Value="#FF1E88E5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Knopf, der ein Auswahlmenü öffnet (zeigt den aktuellen Wert) -->
        <Style x:Key="MenuButton" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="background" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="background" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="background" Property="Background" Value="#70FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <!-- Knöpfe, die den Editor schließen: Symbol dezent eingefärbt (Ausgabe/Abbrechen hellblau, Verwerfen hellrot) -->
        <SolidColorBrush x:Key="ClosingIconBrush" Color="#FF90CAF9" />
        <SolidColorBrush x:Key="DiscardIconBrush" Color="#FFEF9A9A" />
        <Style x:Key="ClosingIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Stroke" Value="{StaticResource ClosingIconBrush}" />
        </Style>
        <Style x:Key="DiscardIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Stroke" Value="{StaticResource DiscardIconBrush}" />
        </Style>
        <!-- Stern „permanent“: gesetzt → gelb gefüllt (bleibt auch beim Darüberfahren sichtbar, anders als der blaue Hintergrund) -->
        <SolidColorBrush x:Key="PermanentStarBrush" Color="#FFFFCA28" />
        <Style x:Key="PermanentStarIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPermanent}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource PermanentStarBrush}" />
                    <Setter Property="Fill" Value="{StaticResource PermanentStarBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="Separator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,6" />
            <Setter Property="Fill" Value="#50FFFFFF" />
        </Style>
        <Style x:Key="PopupPanel" TargetType="Border">
            <Setter Property="Background" Value="#F8262626" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="MenuPopup" TargetType="Popup">
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="StaysOpen" Value="False" />
            <Setter Property="AllowsTransparency" Value="True" />
            <Setter Property="PopupAnimation" Value="None" />
        </Style>
        <!-- Eintrag eines Text-Menüs (Werte, Zeigerarten) -->
        <DataTemplate x:Key="ChoiceTemplate">
            <Button Style="{StaticResource ToolbarButton}" Width="Auto" MinWidth="80" Padding="10,0" HorizontalContentAlignment="Left" Click="onChoiceClick">
                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ThicknessTemplate">
            <Button Style="{StaticResource ToolbarButton}" Width="Auto" MinWidth="90" Padding="10,0" HorizontalContentAlignment="Left" Click="onChoiceClick">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="28" Height="{Binding PreviewThickness}" Fill="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ColorTemplate">
            <Button Style="{StaticResource ToolbarButton}" ToolTip="{Binding Label}" Click="onChoiceClick">
                <Border Width="20" Height="20" CornerRadius="10" BorderBrush="#A0FFFFFF" BorderThickness="1" Background="{Binding Brush}" />
            </Button>
        </DataTemplate>
        <!-- Schachbrett unter Füllfarben, damit Transparenz sichtbar wird -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFBDBDBD" Geometry="M0,0 H8 V8 H0 Z" />
                    <GeometryDrawing Brush="#FF757575" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- Füllfarbe: eckiges Feld (Rahmenfarben sind rund) -->
        <DataTemplate x:Key="FillTemplate">
            <Button Style="{StaticResource ToolbarButton}" ToolTip="{Binding Label}" Click="onChoiceClick">
                <Grid Width="20" Height="20">
                    <Border CornerRadius="3" Background="{StaticResource Checker}" />
                    <Border CornerRadius="3" BorderBrush="#A0FFFFFF" BorderThickness="1" Background="{Binding Brush}" />
                </Grid>
            </Button>
        </DataTemplate>
        <!-- Linienende: Symbol + Text -->
        <DataTemplate x:Key="CapTemplate">
            <Button Style="{StaticResource ToolbarButton}" Width="Auto" MinWidth="100" Padding="8,0" HorizontalContentAlignment="Left" Click="onChoiceClick">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Fill="White" Data="{Binding Icon}" />
                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="#F0262626" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="6" Padding="4">
        <StackPanel Orientation="Horizontal">
            <!-- Abschnitt „tools“: Bereich, Auswahl und Zeichenwerkzeuge -->
            <ItemsControl x:Name="tools" ItemsSource="{Binding Tools}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ToolButton}"
                                ToolTip="{Binding ToolTip}"
                                Command="{Binding DataContext.SelectToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Path Style="{StaticResource Icon}" Data="{Binding Icon}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Abschnitt „options“: nur die zum Werkzeug bzw. ausgewählten Objekt passenden Optionen -->
            <StackPanel x:Name="options" Orientation="Horizontal">
                <Rectangle Style="{StaticResource Separator}" Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVisibility}}" />
                <Grid Visibility="{Binding ShowColorOption, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="colorButton" Style="{StaticResource MenuButton}" Padding="0" ToolTip="{loc:Str OptionColor}"
                                  IsChecked="{Binding IsOpen, ElementName=colorPopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=colorPopup, Converter={StaticResource InverseBool}}">
                        <Border Width="20" Height="20" CornerRadius="10" BorderBrush="White" BorderThickness="1.5" Background="{Binding CurrentColorBrush}" />
                    </ToggleButton>
                    <Popup x:Name="colorPopup" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=colorButton}">
                        <Border Style="{StaticResource PopupPanel}">
                            <ItemsControl ItemsSource="{Binding ColorChoices}" ItemTemplate="{StaticResource ColorTemplate}" Width="180" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>
                <Grid Visibility="{Binding ShowThicknessOption, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="thicknessButton" Style="{StaticResource MenuButton}" ToolTip="{loc:Str OptionThickness}"
                                  IsChecked="{Binding IsOpen, ElementName=thicknessPopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=thicknessPopup, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="M3,5 H17 M3,10 H17 M3,15 H17" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding CurrentThicknessText}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="thicknessPopup" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=thicknessButton}">
                        <Border Style="{StaticResource PopupPanel}">
                            <ItemsControl ItemsSource="{Binding ThicknessChoices}" ItemTemplate="{StaticResource ThicknessTemplate}" Focusable="False" />
                        </Border>
                    </Popup>
                </Grid>
                <Grid Visibility="{Binding ShowFillColorOption, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="fillButton" Style="{StaticResource MenuButton}" Padding="0" ToolTip="{loc:Str OptionFill}"
                                  IsChecked="{Binding IsOpen, ElementName=fillPopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=fillPopup, Converter={StaticResource InverseBool}}">
                        <Grid Width="20" Height="20">
                            <Border CornerRadius="3" Background="{StaticResource Checker}" />
                            <Border CornerRadius="3" BorderBrush="White" BorderThickness="1.5" Background="{Binding CurrentFillBrush}" />
                        </Grid>
                    </ToggleButton>
                    <Popup x:Name="fillPopup" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=fillButton}">
                        <Border Style="{StaticResource PopupPanel}">
                            <ItemsControl ItemsSource="{Binding FillColorChoices}" ItemTemplate="{StaticResource FillTemplate}" Width="216" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>
                <Button Style="{StaticResource StateButton}" Tag="{Binding IsTextBackgroundActive}" Command="{Binding ToggleTextBackgroundCommand}" ToolTip="{loc:Str OptionTextBackground}"
                        Visibility="{Binding ShowTextBackgroundOption, Converter={StaticResource BoolToVisibility}}">
                    <Path Style="{StaticResource Icon}" Data="M4,4 H16 V16 H4 Z M4,10 L10,4 M4,16 L16,4 M10,16 L16,10" />
                </Button>
                <Grid Visibility="{Binding ShowLineCapOptions, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="startCapButton" Style="{StaticResource MenuButton}" ToolTip="{loc:Str OptionStartCap}"
                                  IsChecked="{Binding IsOpen, ElementName=startCapPopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=startCapPopup, Converter={StaticResource InverseBool}}">
                        <Path Style="{StaticResource Icon}" Fill="White" Data="{Binding CurrentStartCapIcon}" />
                    </ToggleButton>
                    <Popup x:Name="startCapPopup" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=startCapButton}">
                        <Border Style="{StaticResource PopupPanel}">
                            <ItemsControl ItemsSource="{Binding StartCapChoices}" ItemTemplate="{StaticResource CapTemplate}" Focusable="False" />
                        </Border>
                    </Popup>
                </Grid>
                <Grid Visibility="{Binding ShowLineCapOptions, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="endCapButton" Style="{StaticResource MenuButton}" ToolTip="{loc:Str OptionEndCap}"
                                  IsChecked="{Binding IsOpen, ElementName=endCapPopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=endCapPopup, Converter={StaticResource InverseBool}}">
                        <Path Style="{StaticResource Icon}" Fill="White" Data="{Binding CurrentEndCapIcon}" />
                    </ToggleButton>
                    <Popup x:Name="endCapPopup" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=endCapButton}">
                        <Border Style="{StaticResource PopupPanel}">
                            <ItemsControl ItemsSource="{Binding EndCapChoices}" ItemTemplate="{StaticResource CapTemplate}" Focusable="False" />
                        </Border>
                    </Popup>
                </Grid>
                <Button Style="{StaticResource StateButton}" Tag="{Binding IsSmoothActive}" Command="{Binding ToggleSmoothCommand}" ToolTip="{loc:Str OptionSmooth}"
                        Visibility="{Binding ShowSmoothOption, Converter={StaticResource BoolToVisibility}}">
                    <Path Style="{StaticResource Icon}" Data="M3,14 C6,3 14,17 17,6" />
                </Button>
                <Grid Visibility="{Binding ShowFontSizeOption, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="fontSizeButton" Style="{StaticResource MenuButton}" ToolTip="{loc:Str OptionFontSize}"
                                  IsChecked="{Binding IsOpen, ElementName=fontSizePopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=fontSizePopup, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="M2,16 L7,4 L12,16 M4,12 H10 M13,16 L15.5,10 L18,16 M14,14 H17" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding CurrentFontSizeText}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="fontSizePopup" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=fontSizeButton}">
                        <Border Style="{StaticResource PopupPanel}">
                            <ItemsControl ItemsSource="{Binding FontSizeChoices}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False" />
                        </Border>
                    </Popup>
                </Grid>
                <Grid Visibility="{Binding ShowBlockSizeOption, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="blockSizeButton" Style="{StaticResource MenuButton}" ToolTip="{loc:Str OptionBlockSize}"
                                  IsChecked="{Binding IsOpen, ElementName=blockSizePopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=blockSizePopup, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="M3,3 H17 V17 H3 Z M3,10 H17 M10,3 V17" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding CurrentBlockSizeText}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="blockSizePopup" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=blockSizeButton}">
                        <Border Style="{StaticResource PopupPanel}">
                            <ItemsControl ItemsSource="{Binding BlockSizeChoices}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False" />
                        </Border>
                    </Popup>
                </Grid>
                <Grid Visibility="{Binding ShowBlurRadiusOption, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="blurButton" Style="{StaticResource MenuButton}" ToolTip="{loc:Str OptionBlurRadius}"
                                  IsChecked="{Binding IsOpen, ElementName=blurPopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=blurPopup, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="M10,3 C10,3 4,9.5 4,12.5 A6,6 0 0 0 16,12.5 C16,9.5 10,3 10,3 Z" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding CurrentBlurRadiusText}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="blurPopup" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=blurButton}">
                        <Border Style="{StaticResource PopupPanel}">
                            <ItemsControl ItemsSource="{Binding BlurRadiusChoices}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False" />
                        </Border>
                    </Popup>
                </Grid>
                <Grid Visibility="{Binding ShowStampSizeOption, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="stampSizeButton" Style="{StaticResource MenuButton}" ToolTip="{loc:Str OptionStampSize}"
                                  IsChecked="{Binding IsOpen, ElementName=stampSizePopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=stampSizePopup, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="M3,10 A7,7 0 1 1 17,10 A7,7 0 1 1 3,10 Z" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding CurrentStampSizeText}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="stampSizePopup" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=stampSizeButton}">
                        <Border Style="{StaticResource PopupPanel}">
                            <ItemsControl ItemsSource="{Binding StampSizeChoices}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False" />
                        </Border>
                    </Popup>
                </Grid>
                <Grid Visibility="{Binding ShowCursorKindOption, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton x:Name="cursorKindButton" Style="{StaticResource MenuButton}" ToolTip="{loc:Str OptionCursorKind}"
                                  IsChecked="{Binding IsOpen, ElementName=cursorKindPopup}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=cursorKindPopup, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="M5,2.5 V16 L8.5,12.5 L11,18 L13,17 L10.5,11.5 L15,11.5 Z" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding CurrentCursorKindLabel}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="cursorKindPopup" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=cursorKindButton}">
                        <Border Style="{StaticResource PopupPanel}">
                            <ItemsControl ItemsSource="{Binding CursorKindChoices}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False" />
                        </Border>
                    </Popup>
                </Grid>
                <Button Style="{StaticResource StateButton}" Tag="{Binding IsCursorVisible}" Command="{Binding ToggleCursorVisibleCommand}" ToolTip="{loc:Str OptionCursorVisible}"
                        Visibility="{Binding ShowCursorVisibleOption, Converter={StaticResource BoolToVisibility}}">
                    <Path Style="{StaticResource Icon}" Data="M2,10 C5,4 15,4 18,10 C15,16 5,16 2,10 Z M7.5,10 A2.5,2.5 0 1 1 12.5,10 A2.5,2.5 0 1 1 7.5,10 Z" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding DeleteSelectedCommand}" ToolTip="{loc:Str ToolbarDeleteObject}"
                        Visibility="{Binding HasSelectedAnnotation, Converter={StaticResource BoolToVisibility}}">
                    <Path Style="{StaticResource Icon}" Data="M4,6 H16 M8,6 V4 H12 V6 M6,6 L7,17 H13 L14,6 M9,9 V14 M11,9 V14" />
                </Button>
            </StackPanel>

            <Rectangle Style="{StaticResource Separator}" />
            <!-- Ausgabe -->
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding CopySelectionCommand}" ToolTip="{loc:Str ToolbarCopySelection}">
                <Path Style="{StaticResource ClosingIcon}" Data="M7,7 H17 V18 H7 Z M4,14 V3 H13" />
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveSelectionCommand}" ToolTip="{loc:Str ToolbarSaveSelection}">
                <Path Style="{StaticResource ClosingIcon}" Data="M3,3 H14 L17,6 V17 H3 Z M6,3 V7 H13 V3 M6,17 V11 H14 V17" />
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveSelectionAsCommand}" ToolTip="{loc:Str ToolbarSaveSelectionAs}">
                <Path Style="{StaticResource ClosingIcon}" Data="M3,3 H12 L15,6 V9 M9,17 H3 V3 M6,3 V7 H11 V3 M11,18 V15.5 L16.5,10 L19,12.5 L13.5,18 Z" />
            </Button>
            <Rectangle Style="{StaticResource Separator}" />
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding CopyFullCommand}" ToolTip="{loc:Str ToolbarCopyFull}">
                <Path Style="{StaticResource ClosingIcon}" Data="M1,4 H9 V11 H1 Z M11,4 H19 V11 H11 Z M5,11 V14 M15,11 V14 M3,16 H17" />
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding CopyMonitorCommand}" ToolTip="{loc:Str ToolbarCopyMonitor}">
                <Path Style="{StaticResource ClosingIcon}" Data="M2,3 H18 V13 H2 Z M10,13 V16 M6,17 H14" />
            </Button>
            <Rectangle Style="{StaticResource Separator}" />
            <!-- Aufnahme: Kopie anlegen, permanent -->
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding DuplicateCommand}" ToolTip="{loc:Str ToolbarDuplicate}">
                <Path Style="{StaticResource Icon}" Data="M6,6 H17 V17 H6 Z M3,13 V3 H13 M11.5,9 V14 M9,11.5 H14" />
            </Button>
            <Button Style="{StaticResource StateButton}" Tag="{Binding IsPermanent}" Command="{Binding TogglePermanentCommand}" ToolTip="{loc:Str ToolbarPermanent}">
                <Path Style="{StaticResource PermanentStarIcon}" Data="M10,2.5 L12.3,7.3 L17.5,7.9 L13.6,11.5 L14.7,16.7 L10,14.1 L5.3,16.7 L6.4,11.5 L2.5,7.9 L7.7,7.3 Z" />
            </Button>
            <Rectangle Style="{StaticResource Separator}" />
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding UndoCommand}" ToolTip="{loc:Str ToolbarUndo}">
                <Path Style="{StaticResource Icon}" Data="M7,3 L3,7 L7,11 M3,7 H12 A5,5 0 0 1 12,17 H8" />
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding RedoCommand}" ToolTip="{loc:Str ToolbarRedo}">
                <Path Style="{StaticResource Icon}" Data="M13,3 L17,7 L13,11 M17,7 H8 A5,5 0 0 0 8,17 H12" />
            </Button>
            <Rectangle Style="{StaticResource Separator}" />
            <!-- Beenden: Aufnahme verwerfen (Mülleimer mit X, nicht zu verwechseln mit „Objekt löschen“), Abbrechen -->
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding DiscardCommand}" ToolTip="{loc:Str ToolbarDiscard}">
                <Path Style="{StaticResource DiscardIcon}" Data="M4,6 H16 M8,6 V4 H12 V6 M6,6 L7,17 H13 L14,6 M8.5,9 L11.5,14 M11.5,9 L8.5,14" />
            </Button>
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding CancelCommand}" ToolTip="{loc:Str ToolbarCancel}">
                <Path Style="{StaticResource ClosingIcon}" Data="M5,5 L15,15 M15,5 L5,15" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
