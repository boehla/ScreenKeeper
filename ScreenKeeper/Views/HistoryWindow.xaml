<Window x:Class="ScreenKeeper.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScreenKeeper.Resources"
        xmlns:vm="clr-namespace:ScreenKeeper.ViewModels"
        xmlns:views="clr-namespace:ScreenKeeper.Views"
        Title="{loc:Str HistoryTitle}"
        Width="860" Height="720" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:TextToVisibilityConverter x:Key="TextToVisibility" />

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="70" />
        </Style>

        <Style x:Key="QuickButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Stern in der Zeile: Umschalter „permanent“ (gefüllt = permanent) -->
        <Style x:Key="PinButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="background" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="background" Property="Background" Value="#20000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinStar" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="#FFAAAAAA" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Data" Value="M10,2.5 L12.3,7.3 L17.5,7.9 L13.6,11.5 L14.7,16.7 L10,14.1 L5.3,16.7 L6.4,11.5 L2.5,7.9 L7.7,7.3 Z" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPermanent}" Value="True">
                    <Setter Property="Stroke" Value="#FFF9A825" />
                    <Setter Property="Fill" Value="#FFFFC107" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <DataTemplate DataType="{x:Type vm:HistoryHeaderRow}">
            <Border Padding="4,14,4,4" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Label}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" Foreground="Gray" Text="{Binding CountText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HistoryItem}">
            <Grid Margin="2,4" Background="Transparent" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="196" Height="112" Background="#FFEDEDED" BorderBrush="#FFCCCCCC" BorderThickness="1">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,4,4,4" VerticalAlignment="Center">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding TimeText}" />
                    <TextBlock Margin="0,2,0,0" Foreground="#FF555555" TextTrimming="CharacterEllipsis"
                               Text="{Binding ForegroundText}" ToolTip="{Binding ForegroundToolTip}"
                               Visibility="{Binding HasForeground, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Kommentar: einzeilig gekürzt, Tooltip mit dem ganzen Text -->
                    <DockPanel Margin="0,3,0,0" Background="Transparent" Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel.ToolTip>
                            <TextBlock Text="{Binding CommentToolTip}" TextWrapping="Wrap" MaxWidth="480" />
                        </DockPanel.ToolTip>
                        <Path DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,5,0" VerticalAlignment="Top" Stretch="None"
                              Stroke="#FF1E88E5" StrokeThickness="1.3" StrokeLineJoin="Round"
                              Data="M2,2.5 H14 V10.5 H7.5 L4.5,13.5 V10.5 H2 Z M4.5,5.5 H11.5 M4.5,8 H9.5" />
                        <TextBlock Foreground="#FF1E3A5F" FontStyle="Italic" TextTrimming="CharacterEllipsis" Text="{Binding CommentText}" />
                    </DockPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <Border Style="{StaticResource Badge}" Background="#FFF9A825" Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="White" Text="{loc:Str HistoryBadgePermanent}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#FF1E88E5" Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="White" Text="{loc:Str HistoryBadgeEdited}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#FF9E9E9E" Visibility="{Binding IsImageOnly, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="White" Text="{loc:Str HistoryBadgeImageOnly}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#FFFB8C00" Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="White" Text="{loc:Str HistoryBadgeBroken}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Foreground="Gray" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Margin="4,2,6,0" VerticalAlignment="Top" Style="{StaticResource PinButton}"
                        Command="{Binding DataContext.TogglePermanentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                        ToolTip="{loc:Str HistoryPermanentTooltip}">
                    <Path Style="{StaticResource PinStar}" />
                </Button>
            </Grid>
        </DataTemplate>

        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,0" />
            <EventSetter Event="MouseDoubleClick" Handler="onItemDoubleClick" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="ItemMenu">
            <MenuItem Header="{loc:Str HistoryEdit}" Command="{Binding EditCommand}" InputGestureText="Enter" FontWeight="Bold" />
            <MenuItem Header="{loc:Str HistoryCopy}" Command="{Binding CopyCommand}" InputGestureText="Strg+C" />
            <MenuItem Header="{loc:Str HistoryDuplicate}" Command="{Binding DuplicateCommand}" InputGestureText="Strg+D" />
            <MenuItem Header="{loc:Str HistoryPermanent}" Command="{Binding TogglePermanentCommand}" InputGestureText="P" />
            <MenuItem Header="{loc:Str HistoryEditComment}" Command="{Binding EditCommentCommand}" InputGestureText="K" />
            <MenuItem Header="{loc:Str HistoryShowInExplorer}" Command="{Binding ShowInExplorerCommand}" />
            <Separator />
            <MenuItem Header="{loc:Str HistoryDelete}" Command="{Binding DeleteCommand}" InputGestureText="Entf" />
            <Separator />
            <MenuItem Header="{loc:Str HistoryRefresh}" Command="{Binding RefreshCommand}" InputGestureText="F5" />
            <MenuItem Header="{loc:Str HistoryOpenFolder}" Command="{Binding OpenFolderCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Aktionen -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="#FFF5F5F5" BorderBrush="#FFDDDDDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="{loc:Str HistoryRefresh}" Command="{Binding RefreshCommand}" ToolTip="F5" />
                    <Button Style="{StaticResource ToolButton}" Margin="0" Content="{loc:Str HistoryOpenFolder}" Command="{Binding OpenFolderCommand}" ToolTip="{Binding RootFolder}" />
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ToolButton}" Content="{loc:Str HistoryEdit}" Command="{Binding EditCommand}" ToolTip="{loc:Str HistoryEditTooltip}" FontWeight="SemiBold" />
                    <Button Style="{StaticResource ToolButton}" Content="{loc:Str HistoryCopy}" Command="{Binding CopyCommand}" ToolTip="{loc:Str HistoryCopyTooltip}" />
                    <Button Style="{StaticResource ToolButton}" Content="{loc:Str HistoryDuplicate}" Command="{Binding DuplicateCommand}" ToolTip="{loc:Str HistoryDuplicateTooltip}" />
                    <Button Style="{StaticResource ToolButton}" Content="{loc:Str HistoryPermanent}" Command="{Binding TogglePermanentCommand}" ToolTip="{loc:Str HistoryPermanentTooltip}" />
                    <Button Style="{StaticResource ToolButton}" Content="{loc:Str HistoryEditComment}" Command="{Binding EditCommentCommand}" ToolTip="{loc:Str HistoryEditCommentTooltip}" />
                    <Button Style="{StaticResource ToolButton}" Content="{loc:Str HistoryShowInExplorer}" Command="{Binding ShowInExplorerCommand}" />
                    <Button Style="{StaticResource ToolButton}" Content="{loc:Str HistoryDelete}" Command="{Binding DeleteCommand}" ToolTip="{loc:Str HistoryDeleteTooltip}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Filter -->
        <Border DockPanel.Dock="Top" Padding="10,6" BorderBrush="#FFDDDDDD" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{loc:Str HistoryFilterFrom}" />
                <DatePicker Width="120" Margin="0,2,10,2" SelectedDate="{Binding FilterFrom}" />
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{loc:Str HistoryFilterTo}" />
                <DatePicker Width="120" Margin="0,2,14,2" SelectedDate="{Binding FilterTo}" />
                <Button Style="{StaticResource QuickButton}" Margin="0,2,4,2" Content="{loc:Str HistoryQuickToday}" Command="{Binding QuickRangeCommand}" CommandParameter="Today" />
                <Button Style="{StaticResource QuickButton}" Margin="0,2,4,2" Content="{loc:Str HistoryQuick7Days}" Command="{Binding QuickRangeCommand}" CommandParameter="Last7Days" />
                <Button Style="{StaticResource QuickButton}" Margin="0,2,4,2" Content="{loc:Str HistoryQuick30Days}" Command="{Binding QuickRangeCommand}" CommandParameter="Last30Days" />
                <Button Style="{StaticResource QuickButton}" Margin="0,2,4,2" Content="{loc:Str HistoryQuickAll}" Command="{Binding QuickRangeCommand}" CommandParameter="All" />
                <ToggleButton Margin="0,2,14,2" Padding="10,4" Content="{loc:Str HistoryFilterPermanent}" IsChecked="{Binding FilterPermanent}" ToolTip="{loc:Str HistoryFilterPermanentTooltip}" />
                <Grid Width="250" Margin="0,2">
                    <TextBox x:Name="searchBox" VerticalContentAlignment="Center" Padding="4,2" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    <TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="Gray" IsHitTestVisible="False" Text="{loc:Str HistorySearchPlaceholder}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=searchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </WrapPanel>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" Background="#FFF5F5F5" BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="80" Height="10" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <!-- Update: unaufdringlicher Link bzw. Fortschritt/Fehler, keine Dialoge -->
                <TextBlock DockPanel.Dock="Right" Margin="0,0,12,0" Visibility="{Binding Update.ShowLink, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <Hyperlink Command="{Binding Update.InstallCommand}"><Run Text="{Binding Update.LinkText, Mode=OneWay}" /></Hyperlink>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" Margin="0,0,12,0" Foreground="#FF555555" Text="{Binding Update.StatusText}"
                           Visibility="{Binding Update.HasStatus, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                <TextBlock DockPanel.Dock="Right" Margin="0,0,12,0" Foreground="#FF2E7D32" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <ListBox x:Name="list"
                     ItemsSource="{Binding Rows}"
                     SelectionMode="Extended"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource RowContainer}"
                     ContextMenu="{StaticResource ItemMenu}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="1,1"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     SelectionChanged="onSelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
                    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
                    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}" />
                    <KeyBinding Key="P" Command="{Binding TogglePermanentCommand}" />
                    <KeyBinding Key="K" Command="{Binding EditCommentCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                </ListBox.InputBindings>
            </ListBox>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="Gray" TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                       Text="{Binding StatusText}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</Window>
