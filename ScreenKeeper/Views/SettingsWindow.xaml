<Window x:Class="ScreenKeeper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScreenKeeper.Resources"
        xmlns:views="clr-namespace:ScreenKeeper.Views"
        Title="{loc:Str SettingsTitle}"
        Width="680" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:TextToVisibilityConverter x:Key="TextToVisibility" />

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>
        <Style x:Key="Info" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,4" />
        </Style>
        <Style x:Key="Error" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFC62828" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,4" />
            <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource TextToVisibility}}" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Margin" Value="6,2,0,2" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Width" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Farbpalette: Listbox mit Farbfeldern, Auswahl = Rahmen -->
        <Style x:Key="PaletteList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="SelectedValuePath" Value="Hex" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Width="22" Height="22" Background="{Binding Brush}" BorderBrush="#FF888888" BorderThickness="1" ToolTip="{Binding Hex}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="Margin" Value="0,0,3,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="frame" Padding="2" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="frame" Property="BorderBrush" Value="#FF1E88E5" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="frame" Property="Background" Value="#FFE3F2FD" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Knöpfe -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button MinWidth="90" Padding="10,4" IsDefault="True" Content="{loc:Str SettingsOk}" Command="{Binding OkCommand}" />
                <Button MinWidth="90" Margin="8,0,0,0" Padding="10,4" IsCancel="True" Content="{loc:Str SettingsCancel}" Command="{Binding CancelCommand}" />
                <Button MinWidth="90" Margin="8,0,0,0" Padding="10,4" Content="{loc:Str SettingsApply}" Command="{Binding ApplyCommand}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="#FF2E7D32" TextTrimming="CharacterEllipsis" Text="{Binding SavedMessage}" />
        </DockPanel>

        <TabControl>
            <!-- Allgemein -->
            <TabItem Header="{loc:Str SettingsTabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{loc:Str SettingsStorageFolder}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{loc:Str SettingsDefault}" Command="{Binding ResetStorageCommand}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{loc:Str SettingsBrowse}" Command="{Binding BrowseStorageCommand}" />
                            <TextBox VerticalContentAlignment="Center" Padding="3,2" Text="{Binding StorageFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Error}" Text="{Binding StorageFolderError}" />
                        <TextBlock Style="{StaticResource Info}">
                            <Run Text="{loc:Str SettingsResolvedFolder}" /> <Run Text="{Binding ResolvedStorageFolder, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource Section}" Text="{loc:Str SettingsFileNamePattern}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{loc:Str SettingsDefault}" Command="{Binding ResetPatternCommand}" />
                            <TextBox VerticalContentAlignment="Center" Padding="3,2" Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Error}" Text="{Binding FileNamePatternError}" />
                        <TextBlock Style="{StaticResource Info}" Text="{Binding FileNamePreview}" />
                        <TextBlock Style="{StaticResource Info}" Text="{Binding PatternHelp}" />

                        <TextBlock Style="{StaticResource Section}" Text="{loc:Str SettingsExportFolder}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{loc:Str SettingsDefault}" Command="{Binding ResetExportCommand}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{loc:Str SettingsBrowse}" Command="{Binding BrowseExportCommand}" />
                            <TextBox VerticalContentAlignment="Center" Padding="3,2" Text="{Binding ExportFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Error}" Text="{Binding ExportFolderError}" />
                        <TextBlock Style="{StaticResource Info}">
                            <Run Text="{loc:Str SettingsResolvedFolder}" /> <Run Text="{Binding ResolvedExportFolder, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource Section}" Text="{loc:Str SettingsRetention}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="70" VerticalContentAlignment="Center" Padding="3,2" Text="{Binding RetentionDaysText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Str SettingsRetentionUnit}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Error}" Text="{Binding RetentionError}" />
                        <TextBlock Style="{StaticResource Info}" Text="{Binding RetentionInfo}" />

                        <TextBlock Style="{StaticResource Section}" Text="{loc:Str SettingsProgram}" />
                        <CheckBox Content="{loc:Str SettingsAutostart}" IsChecked="{Binding Autostart}" />
                        <CheckBox Content="{loc:Str SettingsNotifyOnSaveOnly}" IsChecked="{Binding NotifyOnSaveOnly}" />
                        <TextBlock Style="{StaticResource Info}" Margin="0,10,0,0">
                            <Run Text="{loc:Str SettingsFileLocation}" /> <Run Text="{Binding SettingsFilePath, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys -->
            <TabItem Header="{loc:Str SettingsTabHotkeys}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Info}" Margin="0,12,0,4" Text="{loc:Str SettingsHotkeyHelp}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{loc:Str SettingsHotkeyCaptureEdit}" />
                            <views:HotkeyBox Grid.Row="0" Grid.Column="1" Margin="0,3" Padding="3,2" VerticalContentAlignment="Center" Hotkey="{Binding HotkeyCaptureEdit}" RecordingChanged="onRecordingChanged" />
                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SmallButton}" Content="{loc:Str SettingsHotkeyClear}" Command="{Binding ClearHotkeyCommand}" CommandParameter="CaptureEdit" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource Info}" VerticalAlignment="Center" Text="{Binding HotkeyCaptureEditStatus}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{loc:Str SettingsHotkeyCaptureSave}" />
                            <views:HotkeyBox Grid.Row="1" Grid.Column="1" Margin="0,3" Padding="3,2" VerticalContentAlignment="Center" Hotkey="{Binding HotkeyCaptureSave}" RecordingChanged="onRecordingChanged" />
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SmallButton}" Content="{loc:Str SettingsHotkeyClear}" Command="{Binding ClearHotkeyCommand}" CommandParameter="CaptureSave" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource Info}" VerticalAlignment="Center" Text="{Binding HotkeyCaptureSaveStatus}" />

                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{loc:Str SettingsHotkeyHistory}" />
                            <views:HotkeyBox Grid.Row="2" Grid.Column="1" Margin="0,3" Padding="3,2" VerticalContentAlignment="Center" Hotkey="{Binding HotkeyHistory}" RecordingChanged="onRecordingChanged" />
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SmallButton}" Content="{loc:Str SettingsHotkeyClear}" Command="{Binding ClearHotkeyCommand}" CommandParameter="ShowHistory" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource Info}" VerticalAlignment="Center" Text="{Binding HotkeyHistoryStatus}" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Error}" Foreground="#FFB26A00" Text="{Binding HotkeyMessages}" />
                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding PrintScreenStatus}" />
                        <TextBlock Style="{StaticResource Error}" Foreground="#FFB26A00" Text="{Binding SnippingHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Editor -->
            <TabItem Header="{loc:Str SettingsTabEditor}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{loc:Str SettingsMagnifier}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Str SettingsMagnifierZoom}" />
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="4" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="{Binding MagnifierZoom}" />
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding MagnifierZoom, Mode=OneWay}" /><Run Text="×" />
                            </TextBlock>
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{loc:Str SettingsMagnifierSize}" />
                            <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Minimum="80" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding MagnifierSize}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding MagnifierSize, Mode=OneWay}" /><Run Text=" px" />
                            </TextBlock>
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="{loc:Str SettingsColors}" />
                        <TextBlock Style="{StaticResource Label}" Text="{loc:Str SettingsDefaultColor}" />
                        <ListBox Style="{StaticResource PaletteList}" ItemsSource="{Binding Palette}" SelectedValue="{Binding DefaultColor}" />
                        <TextBlock Style="{StaticResource Label}" Text="{loc:Str SettingsHighlightColor}" />
                        <ListBox Style="{StaticResource PaletteList}" ItemsSource="{Binding HighlightPalette}" SelectedValue="{Binding HighlightColor}" />
                        <TextBlock Style="{StaticResource Label}" Text="{loc:Str SettingsDefaultFill}" />
                        <ListBox Style="{StaticResource PaletteList}" ItemsSource="{Binding FillPalette}" SelectedValue="{Binding DefaultFillColor}" />

                        <TextBlock Style="{StaticResource Section}" Text="{loc:Str SettingsToolDefaults}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{loc:Str OptionThickness}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Thicknesses}" SelectedItem="{Binding DefaultThickness}" ItemStringFormat="{}{0} px" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{loc:Str OptionFontSize}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding DefaultFontSize}" ItemStringFormat="{}{0} px" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{loc:Str OptionBlockSize}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding BlockSizes}" SelectedItem="{Binding DefaultBlockSize}" ItemStringFormat="{}{0} px" />
                            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{loc:Str OptionBlurRadius}" />
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding BlurRadii}" SelectedItem="{Binding DefaultBlurRadius}" ItemStringFormat="{}{0} px" />
                            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{loc:Str OptionStampSize}" />
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding StampSizes}" SelectedItem="{Binding DefaultStampSize}" ItemStringFormat="{}{0} px" />
                            <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="{loc:Str OptionCursorKind}" />
                            <ComboBox Grid.Row="5" Grid.Column="1" Width="180" ItemsSource="{Binding CursorKindChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultCursorKind}" />
                        </Grid>
                        <CheckBox Margin="0,8,0,5" Content="{loc:Str OptionTextBackground}" IsChecked="{Binding DefaultTextBackground}" />
                        <CheckBox Content="{loc:Str OptionSmooth}" IsChecked="{Binding DefaultSmooth}" />

                        <TextBlock Style="{StaticResource Section}" Text="{loc:Str SettingsCursor}" />
                        <CheckBox Content="{loc:Str SettingsCursorVisible}" IsChecked="{Binding CursorVisible}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
